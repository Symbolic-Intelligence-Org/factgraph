// PoC: souffle reach-chain — localize failure + extract failure value + carry asrt provenance
// Validated 2026-06-21 with /opt/homebrew/bin/souffle (arm64 native). See README.md.
// base relations carry an asrt_id column (real-system provenance)
.decl customer(c: symbol, asrt: symbol)
.decl tenure(c: symbol, td: number, asrt: symbol)
.decl transfer(t: symbol, c: symbol, kind: symbol, amt: number, asrt: symbol)
.decl subject(c: symbol)
.input customer
.input tenure
.input transfer
.input subject

// ===== branch new_account:  customer(c), tenure(c,td), td < 90 =====
.decl na_r1(c: symbol, a_c: symbol)
.decl na_r2(c: symbol, td: number, a_c: symbol, a_t: symbol)
.decl na_r3(c: symbol, td: number)
.output na_r1
.output na_r2
.output na_r3
na_r1(c, ac)         :- subject(c), customer(c, ac).
na_r2(c, td, ac, at) :- na_r1(c, ac), tenure(c, td, at).
na_r3(c, td)         :- na_r2(c, td, _, _), td < 90.

// ===== branch forwards_out:  customer(c), transfer t by c, kind=out, amt>=20000 =====
.decl fo_r1(c: symbol, a_c: symbol)
.decl fo_r2(c: symbol, t: symbol, kind: symbol, amt: number, a_t: symbol)
.decl fo_r3(c: symbol, t: symbol, amt: number, a_t: symbol)
.decl fo_r4(c: symbol, t: symbol, amt: number, a_t: symbol)
.output fo_r1
.output fo_r2
.output fo_r3
.output fo_r4
fo_r1(c, ac)            :- subject(c), customer(c, ac).
fo_r2(c, t, k, amt, at) :- fo_r1(c, _), transfer(t, c, k, amt, at).
fo_r3(c, t, amt, at)    :- fo_r2(c, t, "out", amt, at).
fo_r4(c, t, amt, at)    :- fo_r3(c, t, amt, at), amt >= 20000.
