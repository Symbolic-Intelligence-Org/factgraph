.decl claim(Asrt:symbol, PredId:symbol, E:symbol, TupDigest:symbol)
.decl claim_arg(Asrt:symbol, Idx:symbol, Val:symbol, Tag:symbol)
.decl meta_time(Asrt:symbol, Key:symbol, EpochNanos:number)
.decl revokes(Revoker:symbol, Revoked:symbol)
.input claim
.input claim_arg
.input meta_time
.input revokes

.decl active(A:symbol)
active(A) :- claim(A,_,_,_), !revokes(_,A).

.decl p_language_name(E:symbol, V0:symbol)
.output p_language_name
p_language_name(E, V0) :- claim(A,"language:name",E,_), active(A), claim_arg(A,"0",V0,TagOut0).

.decl p_person_native__language(E:symbol, V0:symbol)
.output p_person_native__language
.decl cand__p_person_native__language(A:symbol, E:symbol, Ts:number)
cand__p_person_native__language(A,E, Ts) :- claim(A,"person:native_language",E,_), active(A), meta_time(A,"ingested_at",Ts).

.decl max_ts__p_person_native__language(E:symbol, Ts:number)
max_ts__p_person_native__language(E, Ts) :- cand__p_person_native__language(_,E,_), Ts = max t : { cand__p_person_native__language(_,E,t) }.

.decl better_asrt__p_person_native__language(E:symbol, A:symbol)
better_asrt__p_person_native__language(E, A) :- cand__p_person_native__language(A,E, Ts), max_ts__p_person_native__language(E, Ts), cand__p_person_native__language(B,E, Ts), B < A.

.decl chosen_asrt__p_person_native__language(E:symbol, A:symbol)
chosen_asrt__p_person_native__language(E, A) :- cand__p_person_native__language(A,E, Ts), max_ts__p_person_native__language(E, Ts), !better_asrt__p_person_native__language(E, A).

p_person_native__language(E, V0) :- chosen_asrt__p_person_native__language(E, A), claim_arg(A,"0",V0,TagOut0).



