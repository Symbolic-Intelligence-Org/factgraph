# B3 Load Test — do not commit sample files or concrete manifest

# Sample files (may contain PII / copyrighted content)
samples/

# Concrete manifest (only commit the template)
samples_manifest.yaml

# Concrete schema_ir (may contain business details)
test_schema_ir.json

# Run records go under a dated subdir; keep the dir but gitignore the raw files
# while committing the directory structure via .gitkeep.
run_records/*.json
!run_records/.gitkeep

# Final report stays in git (templated), but drafts do not
report/drafts/

# Python cache from the runner script
__pycache__/
*.pyc
