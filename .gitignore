# Ignore all files at repository root by default.
/*
# Keep root directories so nested project files remain trackable.
!/*/
# Keep required root files.
!/README.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/pyproject.toml
!/MANIFEST.in
!/.gitignore
!/.gitattributes

.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
/out/
/archive/
/hnsm-frontend-master/
esa_demo_output/
dora_demo_output/

# pixi environments
.pixi/*
!.pixi/config.toml
